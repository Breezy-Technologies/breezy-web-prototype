# Mapbox public token (pk.*). Leave empty to run fully offline on the bundled
# Beverly Hills / Silver Lake map images.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Base map styles. The default light style can be swapped for Breezy's custom
# style, e.g. mapbox://styles/dev-breezy/<style-id>
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
NEXT_PUBLIC_MAPBOX_SATELLITE_STYLE=mapbox://styles/mapbox/satellite-streets-v12

# Regrid parcel tiles. Leave the token empty to use generated demo parcels.
NEXT_PUBLIC_REGRID_TOKEN=
NEXT_PUBLIC_REGRID_TILE_URL=https://tiles.regrid.com/api/v1/parcels/{z}/{x}/{y}.mvt?token={token}
NEXT_PUBLIC_REGRID_SOURCE_LAYER=parcels

# Boundaries for city / ZIP / county / state outlines come from the US Census
# TIGERweb service through /api/boundary (server side, no key needed).
TIGERWEB_URL=https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/tigerWMS_Current/MapServer
